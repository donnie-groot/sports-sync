name: sync sports
on:
  schedule:
    - cron: '0 8 * * *'
  workflow_dispatch:
jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.14.4'
      - run: pip install -r requirements.txt
      - run: python main.py
        env:
          GOOGLE_TOKEN: ${{ secrets.GOOGLE_TOKEN }}